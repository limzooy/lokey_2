# 댓글 기능용 Postgres 연결 문자열
# Vercel 대시보드 → Storage → Neon 을 붙이면 자동으로 주입되며,
# 로컬에서 테스트할 때만 이 파일을 .env.local 로 복사해 채워 넣으세요.
#
# 반드시 '풀러(pooler)' 주소를 쓰세요. 서버리스에서 커넥션이 고갈되는 것을 막아줍니다.
#   Neon     : postgresql://user:pw@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/db?sslmode=require
#   Supabase : postgresql://user:pw@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 선택: IP 해시에 쓰는 소금값. 길고 무작위한 문자열이면 됩니다.
COMMENT_IP_SALT=
